# Qt (and its pcre2 dependency) feature trimming for the Windows build.
#
# This profile is referenced by BOTH --profile:host and --profile:build (see
# CMakeLists.txt). It has to be, because Qt appears in two contexts:
#   * host  - the Qt we link into and ship with Safir
#   * build - a Qt that is tool_required for the moc/rcc/uic code generators
# Conan recipe default_options (in conanfile.py) only affect the host context,
# so without these options on the build profile the build-context Qt falls back
# to its full default feature set. That drags in glib/harfbuzz/freetype/openssl/
# sqlite3/libpq/md4c/brotli/... and builds a second, redundant Qt from source.
# With the same options on both contexts, the two Qts share a package_id and
# Qt is built exactly once.
#
# Keep this list in sync with what Safir actually uses; it is the single source
# of truth for Qt's configuration (it used to live in conanfile.py).

[options]
qt/*:shared=False
qt/*:opengl=no
qt/*:openssl=False
qt/*:with_vulkan=False
qt/*:with_pcre2=True
qt/*:with_glib=False
qt/*:with_doubleconversion=True
qt/*:with_freetype=False
qt/*:with_harfbuzz=False
qt/*:with_libjpeg=False
qt/*:with_libpng=True
qt/*:with_brotli=False
qt/*:with_md4c=False
qt/*:with_sqlite3=False
qt/*:with_mysql=False
qt/*:with_pq=False
qt/*:with_odbc=False
qt/*:with_openal=False
qt/*:with_zstd=False
qt/*:with_gstreamer=False
qt/*:with_pulseaudio=False
qt/*:with_dbus=False
qt/*:qtactiveqt=False
qt/*:qtcharts=False
qt/*:qtconnectivity=False
qt/*:qtdatavis3d=False
qt/*:qtimageformats=False
qt/*:qtlottie=False
qt/6*:qtmultimedia=False
qt/*:qtnetworkauth=False
qt/*:qtquick3d=False
qt/*:qtquicktimeline=False
qt/*:qtremoteobjects=False
qt/*:qtscxml=False
qt/*:qtsensors=False
qt/*:qtserialbus=False
qt/*:qtserialport=False
qt/*:qtsvg=True
qt/*:qtvirtualkeyboard=False
qt/*:qtwebchannel=False
qt/*:qtwebengine=False
qt/*:qtwebsockets=True
qt/*:qtwebview=False
qt/*:gui=True
qt/*:widgets=True
pcre2/*:shared=False
pcre2/*:with_zlib=False
pcre2/*:with_bzip2=False
