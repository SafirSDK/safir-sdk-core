#!/usr/bin/make -f
.PHONY: override_dh_auto_install install_runtime install_tools install_development install_testsuite override_dh_auto_test override_dh_clideps override_dh_cligacpolicy override_dh_strip override_dh_compress


#upstream wants to control compilation flags
CFLAGS=
CPPFLAGS=
ifneq (,$(filter config=%,$(DEB_BUILD_OPTIONS)))
	CMAKE_BUILD_TYPE = $(patsubst config=%,%,$(filter config=%,$(DEB_BUILD_OPTIONS)))
else
	CMAKE_BUILD_TYPE=RelWithDebInfo
endif

# debhelper compat 12+ replaces HOME with a temp directory, which breaks conan's
# package cache lookup. Read the real home from the passwd database instead.
# LOGNAME is unset under debuild's sanitized environment (e.g. building in a
# container), and "getent passwd" with an empty argument dumps the whole
# database, so fall back to the current user from "id -un".
REAL_HOME := $(shell getent passwd "$${LOGNAME:-$$(id -un)}" | cut -d: -f6)

# build.py injects the git revision (debuild --set-envvar) because this build
# compiles from an unpacked "git archive" tarball with no .git to query. Forward
# it to cmake so safir_show_config --revision reports it. Quoted because the
# status string contains spaces.
GIT_REVISION_ARGS =
ifneq (,$(SAFIR_GIT_REVISION))
GIT_REVISION_ARGS = -DSAFIR_GIT_REVISION:STRING="$(SAFIR_GIT_REVISION)" -DSAFIR_GIT_REVISION_FULL:STRING="$(SAFIR_GIT_REVISION_FULL)" -DSAFIR_GIT_BRANCH:STRING="$(SAFIR_GIT_BRANCH)" -DSAFIR_GIT_STATUS:STRING="$(SAFIR_GIT_STATUS)"
endif

override_dh_auto_configure:
	CONAN_HOME=$(REAL_HOME)/.conan2 dh_auto_configure -- -DCMAKE_BUILD_TYPE:STRING=$(CMAKE_BUILD_TYPE) $(GIT_REVISION_ARGS)

%:
	dh $@ --buildsystem=cmake+ninja --with=cli

# We DO install our .NET/mono assemblies and their publisher-policy assemblies
# into the GAC (see the *.installcligac files and the Policy.*.dll generation in
# src/cmake/CSharpMacros.cmake). But we generate that policy ourselves and register
# it via dh_installcligac. dh_cligacpolicy is the alternative, config-driven way to
# generate GAC policy: it only acts on a package that has a debian/<package>.cligacpolicy
# file, and skips any package without one. We have none, so it is a no-op for us
# apart from its build-dep check, which literal-matches the exact string
# "cli-common-dev (>= 0.5.7)" and so cannot coexist with dh_makeclilibs' proper
# "(>= 0.8~)" requirement on the same line. Skip the no-op tool to drop its spurious
# warning; we keep (>= 0.8~) for dh_makeclilibs and dh_clideps.
override_dh_cligacpolicy:

override_dh_auto_install: install_runtime install_tools install_development install_testsuite

install_runtime: export DESTDIR=$(shell pwd)/debian/safir-sdk-core
install_runtime:
	#run cmake install
	cd obj-$(DEB_BUILD_GNU_TYPE) && /usr/bin/cmake -DCOMPONENT=Runtime -P cmake_install.cmake

	#copy example configuration to /etc
	dh_install debian/safir-sdk-core/usr/share/doc/safir-sdk-core/example_configuration/*.ini etc/safir-sdk-core

	#create some needed directories
	mkdir -p debian/safir-sdk-core/var/lib/safir-sdk-core
	mkdir -p debian/safir-sdk-core/var/lib/safir-sdk-core/dump
	mkdir -p debian/safir-sdk-core/var/log/safir-sdk-core

install_tools: export DESTDIR=$(shell pwd)/debian/safir-sdk-core-tools
install_tools:
	cd obj-$(DEB_BUILD_GNU_TYPE) && /usr/bin/cmake -DCOMPONENT=Tools -P cmake_install.cmake

install_development: export DESTDIR=$(shell pwd)/debian/safir-sdk-core-dev
install_development:
	cd obj-$(DEB_BUILD_GNU_TYPE) && /usr/bin/cmake -DCOMPONENT=Development -P cmake_install.cmake

install_testsuite: export DESTDIR=$(shell pwd)/debian/safir-sdk-core-testsuite
install_testsuite:
	cd obj-$(DEB_BUILD_GNU_TYPE) && /usr/bin/cmake -DCOMPONENT=TestSuite -P cmake_install.cmake

override_dh_auto_test:
	touch obj-$(DEB_BUILD_GNU_TYPE)/DartConfiguration.tcl
	-cd obj-$(DEB_BUILD_GNU_TYPE) && /usr/bin/ctest --output-on-failure -T Test --no-compress-output


#make debug symbols go in separate package
override_dh_strip:
	dh_strip --dbg-package=safir-sdk-core-dbg

#dont compress examples
override_dh_compress:
	dh_compress -X.cpp -X.cs -X.h -X.java -X.resx -X.sql -X.ui -X.html -X.py
