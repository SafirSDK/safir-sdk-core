import os
import sys
import argparse
import subprocess

#This relies on the fact that we're installed in the bin directory on both linux and windows.
install_dir = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..")
sys.path.append(os.path.join(install_dir, "@SAFIR_INSTALL_DESTINATION_PYTHON@"))
from testenv import log

#The test binary is installed in bin, which is on the PATH. It hosts several
#test suites, each selected by passing its name as the single argument. The
#suites use only stub send policies or unicast loopback sockets, so the binary
#is self-contained and needs no runtime configuration.
COMMUNICATION_UNIT_TESTS = "communication_unit_tests"

#The test suites to run, in the same order the binary runs them with no argument.
SUITES = (
    "MessageQueueTest",
    "HeartbeatSenderTest",
    "DataReceiverTest",
    "DataSenderTest",
    "DeliveryHandlerTest",
    "DiscovererTest",
    "ResolverTest",
    "AllocatorTest",
)


def run():
    failed = []
    for suite in SUITES:
        log("=" * 60)
        log("Running communication test suite: " + suite)
        result = subprocess.call((COMMUNICATION_UNIT_TESTS, suite))
        if result != 0:
            log("*** Suite '%s' failed with return code %d" % (suite, result))
            failed.append(suite)
    return failed


def main():
    failed = run()
    log("=" * 60)
    if failed:
        log("*** FAILURE: %d communication test suite(s) failed: %s"
            % (len(failed), ", ".join(failed)))
        return 1
    log("*** SUCCESS: all communication test suites passed")
    return 0


if __name__ == "__main__":
    argparse.ArgumentParser(
        description="System-level test that runs the communication_unit_tests "
        "binary's suites (message queue, heartbeat sender, data receiver/sender, "
        "delivery handler, discoverer, resolver, allocator). The binary is "
        "self-contained and needs no runtime configuration.").parse_args()
    sys.exit(main())
