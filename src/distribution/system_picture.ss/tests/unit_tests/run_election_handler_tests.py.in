import os
import sys
import time
import argparse
import subprocess

#This relies on the fact that we're installed in the bin directory on both linux and windows.
install_dir = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..")
sys.path.append(os.path.join(install_dir, "@SAFIR_INSTALL_DESTINATION_PYTHON@"))
from testenv import log
from junit import JUnitReporter

#The test binary is installed in bin, which is on the PATH. It is a self-contained
#Boost.Test binary that needs no runtime configuration.
ELECTION_HANDLER_TEST = "ElectionHandler_test"

#Each entry is a named case and the extra command line arguments to pass to the
#test binary. The "--" separates Boost.Test's own arguments from the custom
#--overflows argument that the test parses itself.
CASES = (
    ("plain", ()),
    ("with_overflows", ("--", "--overflows")),
)


def run(reporter):
    for name, extra_args in CASES:
        log("=" * 60)
        log("Running ElectionHandler test case: " + name)
        start = time.time()
        result = subprocess.call((ELECTION_HANDLER_TEST,) + extra_args)
        reporter.add_case(name, result == 0, time.time() - start,
                          "" if result == 0 else "exited with code %d" % result)
        if result != 0:
            log("*** Case '%s' failed with return code %d" % (name, result))


def main():
    reporter = JUnitReporter("run_election_handler_tests")
    run(reporter)
    reporter.write()
    log("=" * 60)
    if reporter.num_failed:
        log("*** FAILURE: %d of %d election handler test case(s) failed"
            % (reporter.num_failed, reporter.num_run))
        return 1
    log("*** SUCCESS: all election handler test cases passed")
    return 0


if __name__ == "__main__":
    argparse.ArgumentParser(
        description="System-level test that runs the ElectionHandler Boost.Test "
        "binary in its two variants (plain and with simulated send overflows). "
        "The binary is self-contained and needs no runtime configuration.").parse_args()
    sys.exit(main())
