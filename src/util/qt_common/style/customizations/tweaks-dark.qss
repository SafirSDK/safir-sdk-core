QLabel#ConnectedLabelConnected {
    color: lightgreen;
}

QLabel#ConnectedLabelDisconnected {
    color: red;
}

QLabel#SocketStatusLabelOk {
    color: lightgreen;
}

QLabel#SocketStatusLabelFallback {
    color: orange;
    font-weight: bold;
}

/*
A failed bind or multicast join means that no tracer output at all will ever
reach the viewer, so make it stand out as much as possible.
*/
QLabel#SocketStatusLabelError {
    color: #FFFFFF;
    background-color: #C0392B;
    font-weight: bold;
    border-radius: 3px;
    padding: 0px 6px;
}

QFrame#StatusBarSeparator {
    background-color:#19232D;
    border: 0px;
    width:1px;
}

/*
Copy to clipboard buttons in OperationsWidget, no frame.
*/
OperationsWidget > QToolButton {
    border: none;
    background: none;
    qproperty-icon: url(:/img/icons/copy-white.svg);
}

OperationsWidget > QToolButton#randomInstanceBtn {
    qproperty-icon: url(:/img/icons/dice-white.svg);
}

OperationsWidget > QToolButton > QToolTip {
    background-color: #346792;
    color: #DFE1E2;
    border: none;
    padding: 0px;
}

QToolButton#DispatchButton {
    color: #FAB900;
}

FileInfoWidget > QToolButton#openContainingFolderButton {
    qproperty-icon: url(:/img/icons/folderopen-white.svg);
}
