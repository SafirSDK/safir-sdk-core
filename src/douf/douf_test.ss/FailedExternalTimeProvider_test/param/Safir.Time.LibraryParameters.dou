<?xml version="1.0" encoding="utf-8" ?>
  <class xmlns="urn:safir-dots-unit" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <summary>Defines parameters for the time provider library</summary>
    <name>Safir.Time.LibraryParameters</name>
    <baseClass>Safir.Dob.Parametrization</baseClass>
    <parameters>
      <parameter>
        <summary>The name of the library that is the time provider in the system.
                 If this parameter is empty the returned values will be based on boost date_time library.</summary>
        <name>LibraryName</name>
        <type>String</type>
        <value>nonexistent_time_library</value>
      </parameter>
      <parameter>
        <name>UtcTimeFunctionName</name>
        <type>String</type>
        <value>GetUtcTime</value>
      </parameter>
      <parameter>
        <name>LocalTimeOffsetFunctionName</name>
        <type>String</type>
        <value>GetLocalTimeOffset</value>
      </parameter>
    </parameters>
  </class>
