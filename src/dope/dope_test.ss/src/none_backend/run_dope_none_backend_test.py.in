import os
import sys
import argparse

#This relies on the fact that we're installed in the bin directory on both linux and windows.
install_dir = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..")
sys.path.append(os.path.join(install_dir, "@SAFIR_INSTALL_DESTINATION_PYTHON@"))
from testenv import TestEnvInstalled, TestEnvStopper, log

#The test-only binary we launch is installed in bin, which is on the PATH.
ENTITY_OWNER = "entity_owner"

#Set up to use our own test configuration and point the typesystem at the
#installed dou files. The last part of each path is baked in by cmake during
#configuration/installation.
os.environ["SAFIR_TEST_CONFIG_OVERRIDE"] = os.path.join(
    install_dir, "@SAFIR_INSTALL_DESTINATION_TEST_DATA@", "dope", "none_backend", "test_config")
os.environ["SAFIR_TEST_SUITE_DOU_DIRECTORY"] = os.path.join(
    install_dir, "@SAFIR_INSTALL_DESTINATION_DOU_BASE@")


def run():
    env = None
    try:
        log("Set a bunch of entities")
        env = TestEnvInstalled()
        with TestEnvStopper(env):
            env.launchProcess("entity_owner", (ENTITY_OWNER, "set")).wait()
            env.WaitForOutput("entity_owner", "Exiting")

        syslog_output = env.Syslog()
        if len(syslog_output) != 0:
            log("Unexpected syslog output:\n" + syslog_output)
            return 1

        if not env.ReturnCodesOk():
            log("Some process exited with an unexpected value")
            return 1

        log("See if dope loads them at startup")
        env = TestEnvInstalled()
        with TestEnvStopper(env):
            env.launchProcess("entity_owner", (ENTITY_OWNER, "accept")).wait()

        syslog_output = env.Syslog()
        if len(syslog_output) != 0:
            log("Unexpected syslog output:\n" + syslog_output)
            return 1

        if not env.ReturnCodesOk():
            log("Some process exited with an unexpected value")
            return 1

        output = env.Output("entity_owner")
        #The None backend persists nothing, so dope must not inject anything back.
        if output.count("OnInjectedNewEntity") != 0:
            log("could not find the right number of 'OnInjectedNewEntity' in output")
            return 1

        if output.count("<DopeTest.SmallEntity>") != 0:
            log("could not find the right number of 'DopeTest.SmallEntity' in output")
            return 1

        if output.count("<DopeTest.BigEntity>") != 0:
            log("could not find the right number of 'DopeTest.BigEntity' in output")
            return 1

    except:
        log("Unexpected exception!")
        if env is not None:
            syslog_output = env.Syslog()
            if len(syslog_output) != 0:
                log("syslog output:\n" + syslog_output)
        raise

    return 0


def main():
    result = run()
    log("=" * 60)
    if result != 0:
        log("*** FAILURE: dope none backend test failed")
    else:
        log("*** SUCCESS: dope none backend test passed")
    return result


if __name__ == "__main__":
    argparse.ArgumentParser(
        description="System-level test that verifies the DOPE 'None' persistence "
        "backend stores nothing: entities set in one system incarnation are not "
        "injected back when dope is restarted.").parse_args()
    sys.exit(main())
