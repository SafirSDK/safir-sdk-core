<?xml version="1.0" encoding="utf-8"?>
<DoseTest.Items.TestCase>
  <Description xml:space="preserve">Testing of Pending entity handler registrations between nodes</Description>
  <Expectation xml:space="preserve">Partner 1 gets 4 OnInitialInjectionsDone, all but the first is preceeded by an OnInjectedNewEntity.  Partner 2 gets OnCompletedRegistration, OnInjectedNewEntity, OnInitialInjectionsDone, OnRevokedRegistration. This sequence is repeated 3 times.</Expectation>
  <TestCaseSetupActions>
    <DoseTest.Action index="0">
      <ActionKind>SubscribeRegistration</ActionKind>
      <Partner>0</Partner>
      <Consumer>0</Consumer>
      <TypeId>DoseTest.SynchronousPermanentEntity</TypeId>
      <Handler>ALL_HANDLERS</Handler>
      <IncludeSubclasses>true</IncludeSubclasses>
      <RestartSubscription>false</RestartSubscription>
    </DoseTest.Action>
    <DoseTest.Action index="1">
      <ActionKind>RegisterEntityHandlerPending</ActionKind>
      <Partner>2</Partner>
      <ActionCallback>OnRevokedRegistration</ActionCallback>
      <Consumer>0</Consumer>
      <TypeId>DoseTest.SynchronousPermanentEntity</TypeId>
      <Handler>DEFAULT_HANDLER</Handler>
      <InstanceIdPolicy>RequestorDecidesInstanceId</InstanceIdPolicy>
    </DoseTest.Action>
  </TestCaseSetupActions>
  <TestActions>
    <DoseTest.Action index="0">
      <ActionKind>RegisterEntityHandlerInjection</ActionKind>
      <Partner>1</Partner>
      <Consumer>0</Consumer>
      <TypeId>DoseTest.SynchronousPermanentEntity</TypeId>
      <Handler>DEFAULT_HANDLER</Handler>
      <InstanceIdPolicy>RequestorDecidesInstanceId</InstanceIdPolicy>
    </DoseTest.Action>
    <DoseTest.Action index="1">
      <ActionKind>SetAll</ActionKind>
      <Partner>1</Partner>
      <Consumer>0</Consumer>
      <Instance>0</Instance>
      <Handler>DEFAULT_HANDLER</Handler>
      <Object type="DoseTest.SynchronousPermanentEntity">
        <Info xml:space="preserve">Some info</Info>
      </Object>
    </DoseTest.Action>
    <DoseTest.Action index="2">
      <ActionKind>RegisterEntityHandlerPending</ActionKind>
      <Partner>2</Partner>
      <Consumer>0</Consumer>
      <TypeId>DoseTest.SynchronousPermanentEntity</TypeId>
      <Handler>DEFAULT_HANDLER</Handler>
      <InstanceIdPolicy>RequestorDecidesInstanceId</InstanceIdPolicy>
    </DoseTest.Action>
    <!-- Stays a sleep on purpose. It follows the pending registration on partner 2,
         and a pending registration that cannot complete yet produces no callback at
         all - that is what makes it pending - so there is no event to wait for. The
         wait here is for the pending registration to have reached the system before
         partner 1 closes below. -->
    <DoseTest.Action index="3">
      <ActionKind>Sleep</ActionKind>
      <SleepDuration>10</SleepDuration>
    </DoseTest.Action>
    <DoseTest.Action index="4">
      <ActionKind>Close</ActionKind>
      <Partner>1</Partner>
    </DoseTest.Action>
    <!-- Wait for the injection handover to finish. OnInitialInjectionsDone is the
         right callback to wait for because it is the last of its group: the completed
         or revoked registration and the injected entity both precede it. -->
    <DoseTest.Action index="5">
      <ActionKind>WaitForCallback</ActionKind>
      <Partner>2</Partner>
      <WaitForCallbackId>OnInitialInjectionsDone</WaitForCallbackId>
      <WaitForCallbackOccurrence>1</WaitForCallbackOccurrence>
    </DoseTest.Action>
    <DoseTest.Action index="6">
      <ActionKind>Open</ActionKind>
      <Partner>1</Partner>
    </DoseTest.Action>
    <DoseTest.Action index="7">
      <ActionKind>RegisterEntityHandlerInjection</ActionKind>
      <Partner>1</Partner>
      <Consumer>0</Consumer>
      <TypeId>DoseTest.SynchronousPermanentEntity</TypeId>
      <Handler>DEFAULT_HANDLER</Handler>
      <InstanceIdPolicy>RequestorDecidesInstanceId</InstanceIdPolicy>
    </DoseTest.Action>
    <!-- Wait for the injection handover to finish. OnInitialInjectionsDone is the
         right callback to wait for because it is the last of its group: the completed
         or revoked registration and the injected entity both precede it. -->
    <DoseTest.Action index="8">
      <ActionKind>WaitForCallback</ActionKind>
      <Partner>1</Partner>
      <WaitForCallbackId>OnInitialInjectionsDone</WaitForCallbackId>
      <WaitForCallbackOccurrence>2</WaitForCallbackOccurrence>
    </DoseTest.Action>
    <DoseTest.Action index="9">
      <ActionKind>Close</ActionKind>
      <Partner>1</Partner>
    </DoseTest.Action>
    <!-- Wait for the injection handover to finish. OnInitialInjectionsDone is the
         right callback to wait for because it is the last of its group: the completed
         or revoked registration and the injected entity both precede it. -->
    <DoseTest.Action index="10">
      <ActionKind>WaitForCallback</ActionKind>
      <Partner>2</Partner>
      <WaitForCallbackId>OnInitialInjectionsDone</WaitForCallbackId>
      <WaitForCallbackOccurrence>2</WaitForCallbackOccurrence>
    </DoseTest.Action>
    <DoseTest.Action index="11">
      <ActionKind>Open</ActionKind>
      <Partner>1</Partner>
    </DoseTest.Action>
    <DoseTest.Action index="12">
      <ActionKind>RegisterEntityHandlerInjection</ActionKind>
      <Partner>1</Partner>
      <Consumer>0</Consumer>
      <TypeId>DoseTest.SynchronousPermanentEntity</TypeId>
      <Handler>DEFAULT_HANDLER</Handler>
      <InstanceIdPolicy>RequestorDecidesInstanceId</InstanceIdPolicy>
    </DoseTest.Action>
    <!-- Wait for the injection handover to finish. OnInitialInjectionsDone is the
         right callback to wait for because it is the last of its group: the completed
         or revoked registration and the injected entity both precede it. -->
    <DoseTest.Action index="13">
      <ActionKind>WaitForCallback</ActionKind>
      <Partner>1</Partner>
      <WaitForCallbackId>OnInitialInjectionsDone</WaitForCallbackId>
      <WaitForCallbackOccurrence>3</WaitForCallbackOccurrence>
    </DoseTest.Action>
    <DoseTest.Action index="14">
      <ActionKind>Close</ActionKind>
      <Partner>1</Partner>
    </DoseTest.Action>
    <!-- Wait for the injection handover to finish. OnInitialInjectionsDone is the
         right callback to wait for because it is the last of its group: the completed
         or revoked registration and the injected entity both precede it. -->
    <DoseTest.Action index="15">
      <ActionKind>WaitForCallback</ActionKind>
      <Partner>2</Partner>
      <WaitForCallbackId>OnInitialInjectionsDone</WaitForCallbackId>
      <WaitForCallbackOccurrence>3</WaitForCallbackOccurrence>
    </DoseTest.Action>
    <DoseTest.Action index="16">
      <ActionKind>Open</ActionKind>
      <Partner>1</Partner>
    </DoseTest.Action>
    <!-- Stays a sleep on purpose: opening a connection produces no test-visible
         callback, so there is nothing to wait for before registering below. -->
    <DoseTest.Action index="17">
      <ActionKind>Sleep</ActionKind>
      <SleepDuration>10</SleepDuration>
    </DoseTest.Action>
    <DoseTest.Action index="18">
      <ActionKind>RegisterEntityHandlerInjection</ActionKind>
      <Partner>1</Partner>
      <Consumer>0</Consumer>
      <TypeId>DoseTest.SynchronousPermanentEntity</TypeId>
      <Handler>DEFAULT_HANDLER</Handler>
      <InstanceIdPolicy>RequestorDecidesInstanceId</InstanceIdPolicy>
    </DoseTest.Action>
    <!-- Wait for the injection handover to finish. OnInitialInjectionsDone is the
         right callback to wait for because it is the last of its group: the completed
         or revoked registration and the injected entity both precede it. -->
    <DoseTest.Action index="19">
      <ActionKind>WaitForCallback</ActionKind>
      <Partner>1</Partner>
      <WaitForCallbackId>OnInitialInjectionsDone</WaitForCallbackId>
      <WaitForCallbackOccurrence>4</WaitForCallbackOccurrence>
    </DoseTest.Action>
    <DoseTest.Action index="20">
      <ActionKind>UnsubscribeRegistration</ActionKind>
      <Partner>0</Partner>
      <Consumer>0</Consumer>
      <TypeId>DoseTest.SynchronousPermanentEntity</TypeId>
      <Handler>ALL_HANDLERS</Handler>
      <IncludeSubclasses>true</IncludeSubclasses>
    </DoseTest.Action>
    <DoseTest.Action index="21">
      <ActionKind>Delete</ActionKind>
      <Partner>1</Partner>
      <Consumer>0</Consumer>
      <Handler>DEFAULT_HANDLER</Handler>
      <EntityId>
        <name>DoseTest.SynchronousPermanentEntity</name>
        <instanceId>0</instanceId>
      </EntityId>
    </DoseTest.Action>
    <DoseTest.Action index="22">
      <ActionKind>UnregisterHandler</ActionKind>
      <Partner>2</Partner>
      <Consumer>0</Consumer>
      <TypeId>DoseTest.SynchronousPermanentEntity</TypeId>
      <Handler>DEFAULT_HANDLER</Handler>
    </DoseTest.Action>
    <DoseTest.Action index="23">
      <ActionKind>UnregisterHandler</ActionKind>
      <Partner>1</Partner>
      <Consumer>0</Consumer>
      <TypeId>DoseTest.SynchronousPermanentEntity</TypeId>
      <Handler>DEFAULT_HANDLER</Handler>
    </DoseTest.Action>
  </TestActions>
</DoseTest.Items.TestCase>
