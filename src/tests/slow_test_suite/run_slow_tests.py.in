#
# Umbrella runner for the slow, system-level "population 1" test suite. These
# tests are not run as part of ctest; they are installed into the TestSuite
# component and run against an installed package, just like the dose tests (see
# src/tests/dose_test.ss and run_dose_tests). This script simply invokes each of
# the installed per-test driver scripts in turn and reports an aggregate result,
# so a developer can run the whole slow suite locally with a single command
# after installing the package.
#
import os
import re
import sys
import glob
import time
import shutil
import signal
import argparse
import subprocess
import xml.etree.ElementTree as ET

#This relies on the fact that we're installed in the bin directory on both linux and windows.
install_dir = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..")
sys.path.append(os.path.join(install_dir, "@SAFIR_INSTALL_DESTINATION_PYTHON@"))
from output import log

#Used for the up-front multicast loopback precheck (see main). Guarded so the
#umbrella still works if the module is somehow not installed - in that case the
#multicast-dependent tests just report for themselves as before.
try:
    from communication_test_support import check_multicast_loopback
except ImportError:
    check_multicast_loopback = None

#The slow-suite driver scripts, in the order we run them. Each is one of the
#per-test drivers installed into bin by the TestSuite component (bare name on
#linux, name.py on windows - both forms are resolved on the PATH below).
#
#When a new slow test is migrated into the TestSuite component, add its driver
#here so it becomes part of this suite.
DRIVERS = (
    "run_system_picture_component_tests",
    "run_incarnation_and_control_tests",
    "run_light_nodes_clear_state_tests",
    "run_light_nodes_keep_state_tests",
    "run_light_nodes_smart_sync_tests",
    "run_restart_nodes_tests",
    "run_lowmem_basic_operations_tests",
    "run_dope_none_backend_test",
    "run_dope_file_backend_test",
    "run_tracer_backdoor_tests",
    "run_election_handler_tests",
    "run_communication_tests",
)

#The odbc dope backend test needs a configured database, so it is not part of
#the default suite. It can be included with --include-odbc (it is run in CI by
#run_test.py --test database instead).
ODBC_DRIVER = "run_dope_odbc_backend_test"

#Per-driver wall-clock timeout in seconds. A driver that hangs (e.g. a node that
#never reaches its expected state) would otherwise block the whole suite until
#the CI job's global timeout, killing every remaining test with no clue which
#one hung. With a timeout the hung driver is killed (its whole process group,
#see reap_process_group), reported as a TIMEOUT against its own name, and the
#suite carries on. These are generous ceilings - well above the run time
#observed on the slow, shared CI runners (shown in the comments for reference) -
#not tight SLAs: a legitimately slow run must never be killed, and a real hang
#blows past any sane multiple anyway. Anything not listed uses DEFAULT_TIMEOUT.
DEFAULT_TIMEOUT = 900  # 15 min; covers every driver except the ones below
TIMEOUTS = {
    "run_system_picture_component_tests": 7200,  # ~2330 s observed
    "run_restart_nodes_tests":            1800,  # ~550 s observed
    "run_light_nodes_clear_state_tests":  1200,  # ~350 s observed
    "run_light_nodes_keep_state_tests":   1200,  # ~225 s observed
    "run_light_nodes_smart_sync_tests":   1200,  # ~365 s observed
    # Four full node start/stop cycles with disk sleeps; its old ctest cap was
    # 3600 s "for slow machines", so keep that ceiling rather than DEFAULT's 900,
    # which the slowest (Windows) row could plausibly exceed on a healthy run.
    "run_dope_file_backend_test":         3600,
}


def timeout_for(name):
    """The wall-clock timeout (seconds) for a driver."""
    return TIMEOUTS.get(name, DEFAULT_TIMEOUT)

#These drivers rely on working multicast loopback on the host - they use it to
#toggle safir_control's DebugCommandServer (Parameters::NetworkEnabled). On a
#host where multicast loopback does not work (e.g. the multicast route goes out
#a wifi interface that doesn't loop it back) they fail fast, or worse time out.
#We check for it up front and, by default, refuse to run them there.
MULTICAST_DRIVERS = frozenset((
    "run_system_picture_component_tests",
    "run_light_nodes_clear_state_tests",
    "run_light_nodes_keep_state_tests",
    "run_light_nodes_smart_sync_tests",
))


def multicast_loopback_ok():
    """Returns (ok, message). ok is False if the host's multicast loopback does
    not work; message is the diagnostic. check_multicast_loopback() sys.exit()s
    with a diagnostic on failure and returns None on success, so we translate
    that into a return value here."""
    if check_multicast_loopback is None:
        return (True, None)
    try:
        check_multicast_loopback()
        return (True, None)
    except SystemExit as e:
        message = e.code if isinstance(e.code, str) else "multicast loopback check failed"
        return (False, message)
    except Exception as e:
        return (False, "multicast loopback check error: %s" % e)


def resolve_driver(name):
    """Find an installed driver on the PATH, handling both the linux stripped
    name and the windows name.py form. We don't use shutil.which because '.py'
    is not in PATHEXT on windows. Returns the full path, or None if not found."""
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        for candidate in (name, name + ".py"):
            path = os.path.join(directory, candidate)
            if os.path.isfile(path):
                return path
    return None


def reap_process_group(proc):
    """Kill any processes still alive in the driver's process tree.

    A driver that dies uncleanly (e.g. an unhandled exception before its
    TestEnvStopper runs) can leave safir_control/dose_main/dope_main orphaned.
    Since Safir allows only one instance per machine, those orphans would make
    every later driver's safir_control exit immediately - one failing test would
    cascade into all the following ones. We clean up only this driver's
    descendants and never touch an unrelated Safir system a developer may have
    running elsewhere:

      * POSIX: each driver runs in its own process group (start_new_session);
        SIGKILL the whole group.
      * Windows: no session process group here, so recursively kill the driver's
        process tree with `taskkill /F /T` (a good stand-in for the group kill;
        no Job Object needed). This also kills the still-running driver itself,
        which is why the timeout path no longer needs a separate proc.kill().

    The suite runs on Windows too (vs2022/vs2026 rows), so both paths matter.
    """
    if os.name == "posix":
        try:
            os.killpg(proc.pid, signal.SIGKILL)  # proc.pid == pgid (start_new_session)
        except (ProcessLookupError, PermissionError):
            pass  # group already empty, nothing to reap
    else:
        # taskkill returns non-zero when the tree is already gone (nothing to
        # reap) - expected on a clean exit, so swallow it and its output.
        subprocess.call(
            ["taskkill", "/F", "/T", "/PID", str(proc.pid)],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def count_junit_failures(junit_dir):
    """Return (num_files, num_failed_cases) across every *.junit.xml a driver
    wrote into junit_dir. A file we can't parse is counted as one failure (a
    malformed report is itself a problem worth surfacing)."""
    files = glob.glob(os.path.join(junit_dir, "*.junit.xml"))
    failed = 0
    for path in files:
        try:
            root = ET.parse(path).getroot()
        except ET.ParseError:
            log("*** Could not parse junit file '%s'; treating as a failure." % path)
            failed += 1
            continue
        #The file's root is a <testsuite> (our JUnitReporter writes one per
        #driver). Count both failures and errors; fall back to counting child
        #<failure>/<error> elements if the attributes are absent.
        suites = [root] if root.tag == "testsuite" else root.findall("testsuite")
        for suite in suites:
            f = suite.get("failures")
            e = suite.get("errors")
            if f is not None or e is not None:
                failed += int(f or 0) + int(e or 0)
            else:
                failed += len(suite.findall(".//failure")) + len(suite.findall(".//error"))
    return (len(files), failed)


def run_driver(name, timeout, junit_root):
    """Run a single driver, streaming its output, killing it if it exceeds
    timeout seconds. Returns (status, duration) where status is one of:
      "OK"      - ran and every test case passed,
      "FAILED"  - ran and produced junit with one or more failing cases
                  (a test-case failure: carried by the junit, not an infra error),
      "ERROR"   - could not run, or ran but wrote no junit / crashed after all
                  cases passed (an infra failure that should fail the CI job),
      "TIMEOUT" - exceeded its timeout and was killed (an infra failure).
    Each driver gets its own junit subdirectory (via SAFIR_SLOW_TEST_JUNIT_DIR)
    so we can attribute the reports it writes back to it."""
    log("=" * 70)
    log("Running slow test: %s (timeout %d s)" % (name, timeout))
    log("=" * 70)

    script = resolve_driver(name)
    if script is None:
        log("*** Could not find driver '%s' on the PATH. Is the TestSuite "
            "component installed?" % name)
        return ("ERROR", 0.0)

    #Give this driver a fresh, empty junit directory so a report left over from
    #a previous run can never be mistaken for this run's result.
    junit_dir = os.path.join(junit_root, name)
    shutil.rmtree(junit_dir, ignore_errors=True)
    os.makedirs(junit_dir, exist_ok=True)
    env = dict(os.environ)
    env["SAFIR_SLOW_TEST_JUNIT_DIR"] = junit_dir

    #Invoke through the current interpreter rather than by bare name: on windows
    #cmd.exe launches a '.py' file asynchronously and returns 0 immediately,
    #which would falsely report success. Same workaround as run_test.py.
    #start_new_session puts the driver and its descendants in their own process
    #group so we can reap any orphans afterwards (see reap_process_group).
    start = time.time()
    proc = subprocess.Popen(
        [sys.executable, script],
        env=env,
        start_new_session=(os.name == "posix"))
    timed_out = False
    try:
        result = proc.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        timed_out = True
        result = None
    finally:
        #Reap the driver's whole process tree after every run, not just on
        #timeout: a driver that crashed before its TestEnvStopper ran can leave
        #orphans too, and either way they would cascade into every later driver
        #(see reap_process_group). This kills the still-running driver itself on
        #timeout (SIGKILL to the group on posix, taskkill /T on windows), so we
        #then reap the now-dead child to avoid leaving a zombie.
        reap_process_group(proc)
        if timed_out:
            try:
                proc.wait(timeout=10)
            except subprocess.TimeoutExpired:
                pass
    duration = time.time() - start

    if timed_out:
        log("*** '%s' TIMED OUT after %.1f s (limit %d s) and was killed."
            % (name, duration, timeout))
        return ("TIMEOUT", duration)

    #Classify from the junit the driver wrote, not from its exit code alone: a
    #test-case failure must stay green at the job level (the junit carries it),
    #while a driver that produced no junit, or exited badly with an all-passing
    #report, really did fall over and should fail the job.
    num_files, num_failed = count_junit_failures(junit_dir)
    if name == ODBC_DRIVER and num_files == 0:
        #The odbc backend test is not part of the junit-emitting slow suite proper
        #(it needs a database and only runs via --include-odbc), so it writes no
        #junit; fall back to its exit code.
        return ("OK", duration) if result == 0 else ("FAILED", duration)
    if num_files == 0:
        log("*** '%s' produced no junit report (exit code %s) - treating as an error."
            % (name, result))
        return ("ERROR", duration)
    if num_failed > 0:
        log("*** '%s': %d test case(s) failed (see junit report)." % (name, num_failed))
        return ("FAILED", duration)
    if result != 0:
        log("*** '%s' exited with code %d despite an all-passing report - treating "
            "as an error." % (name, result))
        return ("ERROR", duration)
    return ("OK", duration)


def run(drivers, junit_root):
    results = []
    for name in drivers:
        status, duration = run_driver(name, timeout_for(name), junit_root)
        results.append((name, status, duration))
    return results


def print_summary(results):
    log("=" * 70)
    log("Slow test suite summary")
    log("=" * 70)
    width = max(len(name) for name, _, _ in results)
    for name, status, duration in results:
        log("  %s   %-7s %6.1f s" % (name.ljust(width), status, duration))
    log("=" * 70)


def main():
    parser = argparse.ArgumentParser(
        description="Run the slow, system-level test suite against an installed "
        "Safir SDK Core package. These tests are not part of ctest; they are "
        "installed into the TestSuite component and driven here, one command for "
        "the whole suite (the dose tests are a separate suite, run_dose_tests). "
        "Note: run_tracer_backdoor_tests requires the 'websockets' pip package, "
        "and the odbc dope backend (--include-odbc) requires a configured "
        "database.")
    parser.add_argument("--list", action="store_true",
                        help="List the tests in the suite and exit.")
    parser.add_argument("-k", "--filter", metavar="REGEX",
                        help="Only run tests whose name matches this regex.")
    parser.add_argument("--include-odbc", action="store_true",
                        help="Also run the odbc dope backend test (needs a database).")
    parser.add_argument("--ignore-multicast-check", action="store_true",
                        help="Run the multicast-dependent tests even if the "
                        "up-front multicast loopback check fails. Without this, "
                        "the suite refuses to run them on a host where multicast "
                        "loopback does not work.")
    args = parser.parse_args()

    drivers = list(DRIVERS)
    if args.include_odbc:
        drivers.append(ODBC_DRIVER)

    if args.filter:
        pattern = re.compile(args.filter)
        drivers = [d for d in drivers if pattern.search(d)]

    if not drivers:
        log("*** No tests matched filter '%s'" % args.filter)
        return 1

    if args.list:
        width = max(len(d) for d in drivers)
        for d in drivers:
            print("%s   timeout %d s" % (d.ljust(width), timeout_for(d)))
        return 0

    #If any selected test needs multicast loopback, check it works up front so
    #we fail with a clear explanation instead of a silent per-test fast-fail.
    multicast_selected = [d for d in drivers if d in MULTICAST_DRIVERS]
    if multicast_selected:
        ok, message = multicast_loopback_ok()
        if not ok:
            log("=" * 70)
            log("*** Multicast loopback is not working on this host.")
            if message:
                for line in str(message).splitlines():
                    log("    " + line)
            log("The following selected test(s) rely on it and will not work:")
            for d in multicast_selected:
                log("    " + d)
            if not args.ignore_multicast_check:
                log("Refusing to run. Fix the host (e.g. route local multicast "
                    "to loopback: 'sudo ip route add 239.0.0.0/8 dev lo'), or "
                    "re-run with --ignore-multicast-check to try anyway.")
                log("=" * 70)
                return 1
            log("--ignore-multicast-check given: running them anyway.")
            log("=" * 70)

    #Each driver's JUnit report is written under here, in a per-driver subdir.
    #CI uploads these (**/*.junit.xml) into the consolidated test report.
    junit_root = os.path.abspath(os.path.join(os.getcwd(), "slow_test_junit"))

    results = run(drivers, junit_root)
    print_summary(results)
    log("JUnit reports written under %s" % junit_root)

    #Two distinct signals, mirroring run_dose_tests:
    #  * a test-case FAILURE is carried by the junit; on its own it must not fail
    #    the CI job (exit 1 - run_test.py treats this as green + a red junit),
    #  * an ERROR/TIMEOUT is a real infra failure (a driver that couldn't run,
    #    crashed, or hung) and must fail the job (exit 2).
    errored = [name for name, status, _ in results if status in ("ERROR", "TIMEOUT")]
    failed = [name for name, status, _ in results if status == "FAILED"]
    if errored:
        log("*** ERROR: %d of %d slow test driver(s) failed to run: %s"
            % (len(errored), len(results), ", ".join(errored)))
        if failed:
            log("    (%d further driver(s) had test-case failures: %s)"
                % (len(failed), ", ".join(failed)))
        return 2
    if failed:
        log("*** FAILURE: %d of %d slow test(s) had failing test cases: %s"
            % (len(failed), len(results), ", ".join(failed)))
        return 1
    log("*** SUCCESS: all %d slow test(s) passed" % len(results))
    return 0


if __name__ == "__main__":
    sys.exit(main())
