            <type>EntityId</type>
        </member>
        <member>
            <name>Object</name>
            <type>Object</type>
        </member>
        <member>
            <name>WaitForFreeInstance</name>
            <type>Boolean</type>
        </member>
        <member>
            <name>EnableChangeInformation</name>
            <type>Boolean</type>
        </member>
        <member>
            <name>IncludeUpdates</name>
            <type>Boolean</type>
        </member>
        <member>
            <name>IncludeSubclasses</name>
            <type>Boolean</type>
        </member>
