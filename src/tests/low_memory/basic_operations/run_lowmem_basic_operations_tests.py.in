import time
import os
import sys
import argparse

#This relies on the fact that we're installed in the bin directory on both linux and windows.
install_dir = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..")
sys.path.append(os.path.join(install_dir, "@SAFIR_INSTALL_DESTINATION_PYTHON@"))
from testenv import TestEnvInstalled, TestEnvStopper, log
from junit import JUnitReporter

#The test-only binary we launch is installed in bin, which is on the PATH.
BASIC_OPERATIONS = "basic_operations"

#Set up to use our own test configuration and point the typesystem at the
#installed dou files. The last part of each path is baked in by cmake during
#configuration/installation.
os.environ["SAFIR_TEST_CONFIG_OVERRIDE"] = os.path.join(
    install_dir, "@SAFIR_INSTALL_DESTINATION_TEST_DATA@", "low_memory", "basic_operations", "test_config")
os.environ["SAFIR_TEST_SUITE_DOU_DIRECTORY"] = os.path.join(
    install_dir, "@SAFIR_INSTALL_DESTINATION_DOU_BASE@")


def run_test():
    env = TestEnvInstalled()

    with TestEnvStopper(env):
        env.launchProcess("basic_operations", BASIC_OPERATIONS)
        env.WaitForOutput("basic_operations", "Done")
        env.WaitForProcess("basic_operations")
        log("Waiting for a bit to let dose_main clean up")
        time.sleep(3)
        log("Shutting down")

    log("=" * 60)
    if not env.ReturnCodesOk():
        log("*** FAILURE: some process exited with an unexpected value")
        return 1
    log("*** SUCCESS: low memory basic operations test passed")
    return 0


if __name__ == "__main__":
    argparse.ArgumentParser(
        description="System-level test that exercises basic Dob operations while "
        "the shared memory is driven into its low-memory degradation levels, "
        "verifying the system stays healthy and shuts down cleanly.").parse_args()
    reporter = JUnitReporter("run_lowmem_basic_operations_tests")
    sys.exit(reporter.run_single("lowmem_basic_operations", run_test))
