import subprocess, os, time, sys, re, argparse

parser = argparse.ArgumentParser(
    description="System-level test that starts three Safir nodes and exercises "
    "incarnation handling and node/system control (stopping individual nodes "
    "and the whole system via safir_control_cli, verifying the resulting "
    "system picture connectivity).")
parser.parse_args()

#This relies on the fact that we're installed in the bin directory on both linux and windows.
install_dir = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..")
sys.path.append(os.path.join(install_dir, "@SAFIR_INSTALL_DESTINATION_PYTHON@"))
from testenv import TestEnvInstalled, TestEnvStopper, log
from junit import JUnitReporter

#The system tools we launch are installed in bin, which is on the PATH.
SYSTEM_PICTURE_LISTENER = "system_picture_listener"
SAFIR_CONTROL_CLI = "safir_control_cli"

#Set up to use our own test configuration and point the typesystem at the
#installed dou files. The last part of each path is baked in by cmake during
#configuration/installation.
os.environ["SAFIR_TEST_CONFIG_OVERRIDE"] = os.path.join(
    install_dir, "@SAFIR_INSTALL_DESTINATION_TEST_DATA@", "incarnation_and_control", "test_config")
os.environ["SAFIR_TEST_SUITE_DOU_DIRECTORY"] = os.path.join(
    install_dir, "@SAFIR_INSTALL_DESTINATION_DOU_BASE@")


#starts a node in the given instance and adds the env to the given list
def startNode(safir_instance):
    os.environ["SAFIR_INSTANCE"] = safir_instance

    environ = TestEnvInstalled(start_syslog_server=True if safir_instance == "0" else False,
                               ignore_control_cmd=True if safir_instance == "0" else False)

    del os.environ["SAFIR_INSTANCE"]

    return environ


#kills all nodes by terminating their processes
def killNodeProcesses():

    try:
        if envs[0] is not None:
            syslog_output = envs[0].Syslog()
            if len(syslog_output) != 0:
                log("SYSLOG OUPUT:\n" + syslog_output)
    except KeyError:
        pass

    for i in envs:
        envs[i].killprocs()


#returns a list of nodenames to which the given node (safir_instance) is connected
#by calling system_picture_listener
def readConnectedNodes(safir_instance):

    os.environ["SAFIR_INSTANCE"] = safir_instance

    #launch the system_picture_listener and read the output
    output = subprocess.check_output([SYSTEM_PICTURE_LISTENER, "-o"], universal_newlines=True)

    del os.environ["SAFIR_INSTANCE"]

    return re.findall(r'(?:\sE\s|\s\s\s)(\S+)@', output)


#returns a list of nodeIds to which the given node (safir_instance) is connected
#by calling system_picture_listener
def readconnectedNodeIds(safir_instance):

    os.environ["SAFIR_INSTANCE"] = safir_instance

    #launch the system_picture_listener and read the output
    try:
        output = subprocess.check_output([SYSTEM_PICTURE_LISTENER, "-o"], universal_newlines=True)
    except subprocess.CalledProcessError:
        log("Error: Failed to read connected nodeIds " + safir_instance)
        killNodeProcesses()
        sys.exit(1)

    del os.environ["SAFIR_INSTANCE"]

    return re.findall(r'(?:\sE\s|\s\s\s)S.+\(id = (\S+),', output)


def readconnectedNodeId(safir_instance, nodeName):

    os.environ["SAFIR_INSTANCE"] = safir_instance

    #launch the system_picture_listener and read the output
    try:
        output = subprocess.check_output([SYSTEM_PICTURE_LISTENER, "-o"], universal_newlines=True)
    except subprocess.CalledProcessError:
        log("Error: Failed read nodeId for " + nodeName + " from instance" + safir_instance)
        killNodeProcesses()
        sys.exit(1)

    del os.environ["SAFIR_INSTANCE"]

    matchList = re.findall(r"(?:\sE\s|\s\s\s)" + nodeName + r".+id = (\S+),", output)

    if len(matchList) == 0:
        log("Did not find NodeID: for node with name " + nodeName)

    if len(matchList) == 0:
        return ""
    else:
        return str(matchList[0])


#stops the whole system from the instance given by the safir_instace
def stopSystem(safir_instance):

    os.environ["SAFIR_INSTANCE"] = safir_instance

    log("Trying to stop the system from instance " + safir_instance)

    #launch the safir_control_cli and wait until it exists
    try:
        subprocess.check_call([SAFIR_CONTROL_CLI, "-a", "STOP"], universal_newlines=True)
    except subprocess.CalledProcessError:
        log("Error: Failed to stop the system from instance " + safir_instance)
        killNodeProcesses()
        sys.exit(1)

    del os.environ["SAFIR_INSTANCE"]


#stops the node given nodeId via the safir_control_cli ran at node given by safir_instance
def stopNode(safir_instance, nodeId):

    os.environ["SAFIR_INSTANCE"] = safir_instance

    log("Trying to stop node " + nodeId + " from instance " + safir_instance)

    #launch the safir_control_cli and wait until it exists
    try:
        subprocess.check_call([SAFIR_CONTROL_CLI, "-a", "STOP", "-n", nodeId], universal_newlines=True)
    except subprocess.CalledProcessError:
        log("Error: Failed to stop node with id:" + str(nodeId) + " from instance " + safir_instance)
        killNodeProcesses()
        sys.exit(1)

    del os.environ["SAFIR_INSTANCE"]


#checks if the node given by the safir_instance has a connection to the given nodes
def checkConnectionToNodes(safir_instance, nodes):
    os.environ["SAFIR_INSTANCE"] = safir_instance

    #try for one minute
    for i in range(60):
        connectedNodes = readConnectedNodes(safir_instance)
        connectedNodes.sort()
        nodes.sort()

        if connectedNodes == nodes:
            log("Server_" + safir_instance + " has connection to (only) " + str(nodes))
            return
        time.sleep(1.0)

    log("Error: Server_" + safir_instance + " does not have contact with (only) " + str(nodes) +
          " we have connection to: " + str(connectedNodes))
    killNodeProcesses()
    sys.exit(1)


def waitForProcessExit(node):
    #try for one minute
    for _ in range(120):
        if not envs[node].SafirControlRunning():
            envs[node].killprocs()
            return
        time.sleep(0.5)

    log("Error: Node " + str(node) + " isn't stopping as expected")
    killNodeProcesses()
    sys.exit(1)


envs = dict()


def run_test():
    #start all nodes
    log("Starting nodes 0,1,2")

    try:
        envs[0] = startNode("0")
        envs[1] = startNode("1")
        envs[2] = startNode("2")
    except:
        log("Error: Failed to start nodes 0,1,2")
        killNodeProcesses()
        sys.exit(1)

    #make Server_0 has connection to the other two
    log("Checking that Server_0 has connection to ['Server_0', 'Server_1', 'Server_2']")
    checkConnectionToNodes("0", ['Server_0', 'Server_1', 'Server_2'])

    #stop node two
    log("Stopping node 2 from System_0")
    stopNode("0", readconnectedNodeId('0', "Server_2"))

    #make sure Server_0 has connection to Server_1 only
    log("Checking that Server_0 has connection to ['Server_0', 'Server_1']")
    checkConnectionToNodes("0", ['Server_0', 'Server_1'])

    waitForProcessExit(2)

    #restart node 2
    try:
        log("Starting node 2")
        envs[2] = startNode("2")
    except:
        log("Error: Failed to start node 2")
        killNodeProcesses()
        sys.exit(1)

    #make sure Server_0 has connection to the other two
    log("Checking that Server_0 has connection to ['Server_0', 'Server_1', 'Server_2']")
    checkConnectionToNodes("0", ['Server_0', 'Server_1', 'Server_2'])

    #stop the whole system via safir_control_cli from node 0, note that System_1 is started with the "ignore-control-cmd" flag
    #which will make it not stop. The other nodes will add the current incarnation id to the blacklist and stop
    #when we start the other two again they shall not join System_1
    log("Stopping the system from Server_0, Server_0 should not go down due to being started with --ignore-control-cmd")
    stopSystem('0')

    log("Checking that Server_0 has only to itself")
    checkConnectionToNodes("0", ['Server_0'])

    waitForProcessExit(1)
    waitForProcessExit(2)

    #start Server_1 and Server_2 again
    try:
        log("Starting Server_1 and Server_2")
        envs[1] = startNode("1")
        envs[2] = startNode("2")
    except:
        log("Error: Failed to start Server_1 and Server_2")
        killNodeProcesses()
        sys.exit(1)

    log("Checking that Server_0 has only to itself")
    checkConnectionToNodes("0", ['Server_0'])

    log("Checking that Server_1 has connection to ['Server_1', 'Server_2']")
    checkConnectionToNodes("1", ['Server_1', 'Server_2'])

    #hard kill Server_0 and restart it, see that it joins Server_1 and Server_2 again
    log("Hardkill Server_0")
    envs[0].killprocs()

    waitForProcessExit(0)

    try:
        log("Starting Server_0")
        envs[0] = startNode("0")
    except Exception as e:
        log("Error: Failed to start Server_0. Exception " + str(e))
        killNodeProcesses()
        sys.exit(1)

    #make sure Server_0 has connection to the other two
    checkConnectionToNodes("0", ['Server_0', 'Server_1', 'Server_2'])

    log("Stopping node 1 from System_1")
    stopNode("1", readconnectedNodeId('0', "Server_1"))

    #make sure Server_0 has connection to Server_2 only
    log("Checking that Server_0 has connection to ['Server_0', 'Server_2']")
    checkConnectionToNodes("0", ['Server_0', 'Server_2'])

    #end the test
    log("Ending test, stopping all nodes")

    killNodeProcesses()

    for env in envs:
        if not envs[env].ReturnCodesOk():
            log("Error: Some process exited with an unexpected value")
            sys.exit(1)

    sys.exit(0)


if __name__ == "__main__":
    reporter = JUnitReporter("run_incarnation_and_control_tests")
    sys.exit(reporter.run_single("incarnation_and_control", run_test))
