import os, time, sys, argparse, re

#This relies on the fact that we're installed in the bin directory on both linux and windows.
install_dir = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..")
sys.path.append(os.path.join(install_dir, "@SAFIR_INSTALL_DESTINATION_PYTHON@"))
from testenv import TestEnvInstalled, TestEnvStopper, log

#The test-only binaries we launch are installed in bin, which is on the PATH.
OWNER = "WaitingStatesOwner"
SENDER = "RequestSender"

#Set up to use our own test configuration and point the typesystem at the
#installed dou files. The last part of each path is baked in by cmake during
#configuration/installation.
os.environ["SAFIR_TEST_CONFIG_OVERRIDE"] = os.path.join(
    install_dir, "@SAFIR_INSTALL_DESTINATION_TEST_DATA@", "restart_nodes", "test_config")
os.environ["SAFIR_TEST_SUITE_DOU_DIRECTORY"] = os.path.join(
    install_dir, "@SAFIR_INSTALL_DESTINATION_DOU_BASE@")


def makeaddr(port):
    return "127.0.0.1:" + str(port)


def launch_node(case, instance):
    log("Launching node", instance)
    os.environ["SAFIR_INSTANCE"] = str(instance)
    os.environ["SAFIR_NODE_NAME"] = "Node_" + str(instance)
    os.environ["SAFIR_CONTROL_ADDRESS"] = makeaddr(30000 + instance)
    os.environ["SAFIR_DATA_ADDRESS"] = makeaddr(40000 + instance)
    if instance == 0:
        #We need a space in the address, since otherwise windows will ignore the variable...
        os.environ["SAFIR_SEED_ADDRESS"] = " "
    else:
        os.environ["SAFIR_SEED_ADDRESS"] = makeaddr(30000)
    os.environ["SYSLOG_SERVER_PORT"] = str(20000 + instance)
    env = TestEnvInstalled(with_dope=instance == 0,
                           wait_for_persistence=instance == 0)

    for handler in range(case.handlers):
        if instance == 0:
            cmd = (OWNER, "--handler", str(handler))
            if case.entity_updates:
                cmd += ( "--update", "--update-period", str(case.update_period))
            env.launchProcess(f"WaitingStatesOwner_{handler}", cmd)
        elif case.entity_requests:
            env.launchProcess(f"RequestSender_{handler}", (SENDER, "--handler",  str(handler)))
    return env


#The set of test cases this suite runs. Each one repeatedly restarts the client
#nodes and only differs in what load it puts on the system while nodes come and
#go. These correspond to what used to be three separate ctest entries.
TEST_CASES = {
    "entity_updates_only":
        dict(entity_updates=True, entity_requests=False, handlers=1, update_period=10),
    "entity_requests_only":
        dict(entity_updates=False, entity_requests=True, handlers=2, update_period=10),
    "entity_requests_and_updates":
        dict(entity_updates=True, entity_requests=True, handlers=2, update_period=25),
}


def parse_arguments():
    parser = argparse.ArgumentParser(
        description="System-level test that repeatedly restarts a set of Safir nodes "
        "around a persistent node 0, verifying that the restarted nodes rejoin the "
        "same system incarnation. Runs several cases that drive entity updates and/or "
        "entity requests to exercise the waiting-states and request mechanisms while "
        "nodes come and go.")
    parser.add_argument("-t", "--test-case", default="all",
                        choices=("all", ) + tuple(TEST_CASES),
                        help="Test case to run. The default, 'all', will run them all.")
    parser.add_argument("--clients", type=int, default=@RESTART_NODES_NUM_CLIENTS@,
                        help="number of client nodes restarted around node 0")
    return parser.parse_args()


def run_case(case):
    server = launch_node(case, 0)
    output = server.Output("safir_control")
    incarnation = int(re.search(r"Starting system with incarnation id (.*)", output).group(1))
    log("This system has incarnation", incarnation)

    with TestEnvStopper(server):
        env = dict()
        try:
            for _ in range(3):
                for i in range(1, case.clients + 1):
                    env[i] = launch_node(case, i)

                for i in range(1, case.clients + 1):
                    env[i].WaitForPersistence()
                    output = env[i].Output("safir_control")
                    res = re.search(r"Joined system with incarnation id (.*)", output)
                    if res is None:
                        log("Failed to find join statement in:")
                        log(output)
                        log("Sleeping a while, to see if that will let us join")
                        time.sleep(10)
                        log(env[i].Output("safir_control"))
                        return 1
                    inc = int(res.group(1))
                    if inc != incarnation:
                        log("Joined invalid incarnation!!!!")
                        return 1

                if case.entity_requests:
                    for num in range(case.handlers):
                        for i in range(1, case.clients + 1):
                            log(f"Waiting for instance {i} to have completed sending requests")
                            env[i].WaitForOutput(f"RequestSender_{num}", "Have sent 1000 requests and gotten responses to them")

                for i in range(1, case.clients + 1):
                    log(f"Terminating instance {i}")
                    env[i].killprocs()
                    syslog_output = env[i].Syslog()
                    if len(syslog_output) != 0:
                        log("Unexpected syslog output:\n" + syslog_output)
                        return 1
                    if not env[i].ReturnCodesOk():
                        log("Some process failed")
                        return 1
            log("exiting normally")
        finally:
            log ("cleaning up")
            for i, e in env.items():
                e.killprocs()

    if not server.ReturnCodesOk():
        log("Some process exited with an unexpected value")
        return 1

    return 0


def main():
    args = parse_arguments()

    if args.test_case == "all":
        cases = TEST_CASES
    else:
        cases = {args.test_case: TEST_CASES[args.test_case]}

    failed = []
    for name, params in cases.items():
        log("=" * 60)
        log(f"Running test case '{name}'")
        log("=" * 60)
        case = argparse.Namespace(clients=args.clients, **params)
        if run_case(case) == 0:
            log(f" - '{name}': Success")
        else:
            log(f" - '{name}': Failure")
            failed.append(name)

    log("=" * 60)
    if failed:
        log(f"*** FAILURE: {len(failed)} of {len(cases)} test case(s) failed: "
            + ", ".join(failed))
        return 1
    log(f"*** SUCCESS: all {len(cases)} test case(s) passed")
    return 0


sys.exit(main())
