<?xml version="1.0" encoding="utf-8" ?>
<class xmlns="urn:safir-dots-unit">
  <summary>Configuration parameters for the tracer data multicast sender.</summary>
  <name>Safir.Application.TracerParameters</name>
  <baseClass>Safir.Dob.Parametrization</baseClass>
  <parameters>
    <parameter>
      <summary>Multicast IP address to which the Tracer data is sent.</summary>
      <name>Address</name>
      <type>String</type>
      <value>224.11.11.12</value>
    </parameter>
    <parameter>
      <summary>UDP port to which the Tracer data is sent. Note that this should be kept
      below 49152, since ports from 49152 and upwards belong to the dynamic/ephemeral
      port range, which can be used for automatic port assignment. Binding in that
      range can fail randomly.</summary>
      <name>Port</name>
      <type>Int32</type>
      <value>39500</value>
    </parameter>
    <parameter>
      <summary>Syslog facility code for Tracer syslog output. See Safir::Logging::Facility enum in Safir/Logging/Log.h for valid values (0=Kernel, 1=User, 2=Mail, 3=Daemon, 4=Auth, 5=Syslog, 6=Lpr, 7=News, 8=Uucp, 9=Cron, 10=Authpriv, 11=Ftp, 16=Local0, 17=Local1, 18=Local2, 19=Local3, 20=Local4, 21=Local5, 22=Local6, 23=Local7).</summary>
      <name>SyslogFacility</name>
      <type>Int32</type>
      <value>17</value>
    </parameter>
  </parameters>
</class>
